# Cloudflare Pages reads this file. Two jobs.
#
# Keep the tool out of search results. The pages carry the team's balance
# notes and the internal names of unreleased content, and a crawler that
# indexes them puts both a click away from anybody.
#
# And never let a browser hold on to the HTML. Croc edits this database and
# expects the next reload to show the edit; a cached bundle is the one way a
# staff member reads yesterday's numbers and does not know it.
/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/*.html
  Cache-Control: no-store, must-revalidate

/
  Cache-Control: no-store, must-revalidate

# The sprites never change under a given id, so they are worth keeping.
/sprites/*
  Cache-Control: public, max-age=31536000, immutable
